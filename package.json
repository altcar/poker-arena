{
  "name": "poker-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Play a real player against the five renamed poker bots, with the competition site's matches, matrix, teams and tournament pages.",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:python": "python scripts/python_play.py",
    "verify:js": "node scripts/js_play.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "csv": "node scripts/make_teams_csv.mjs",
    "all-teams": "node scripts/download_team_files.mjs",
    "teams:sync": "node scripts/sync_team_files.mjs",
    "teams:csv": "node scripts/finalize_team_files.mjs",
    "teams:data": "node scripts/make_teams_data.mjs",
    "tournament": "python scripts/run_tournament.py",
    "tournament:merge": "python scripts/merge_tournament.py",
    "tournament:data": "node scripts/make_our_tournament.mjs",
    "browser:team-files": "node scripts/prepare_browser_runtime.mjs",
    "browser:engine": "node scripts/copy_browser_engine.mjs",
    "browser:test": "node scripts/test_pyodide.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.160.0"
  }
}
